// Comptes et espace ambassadeur (décidé le 8 octobre 2026, voir docs/decisions.md)

/// Un compte SOS Miam, un seul par personne : app, espace ambassadeur et espace pro. Inscrit sur le site (ambassadeur, pro),
/// l'âge (18 ans au moins) est vérifié puis oublié ; inscrit dans l'app (dès 15 ans), le nom et la date de naissance sont
/// gardés CHIFFRÉS. Après 1 an sans visite, le rôle d'ambassadeur part ; après 2 ans sans connexion, tout le compte.
model Compte {
  id                    Int       @id @default(autoincrement())
  /// Adresse de connexion, en minuscules et sans espaces
  email                 String    @unique @db.VarChar(254)
  /// Empreinte scrypt qui se décrit elle-même (« scrypt$N$r$p$sel$empreinte ») ; jamais le mot de passe
  motDePasse            String    @map("mot_de_passe") @db.VarChar(200)
  prenom                String    @db.VarChar(40)
  /// Points du programme Ambassadeurs (barème dans docs/decisions.md), tenus par ajouterPoints avec le journal
  points                Int       @default(0)
  /// « curieux », « denicheur », « ambassadeur-quartier » ou « ambassadeur-ville » (ce dernier seulement à la main)
  palier                String    @default("curieux") @db.VarChar(20)
  /// Version des conditions d'utilisation acceptées à l'inscription (leur date de mise à jour, AAAA-MM-JJ)
  cguVersion            String    @map("cgu_version") @db.VarChar(10)
  /// Nouveau mot de passe, lien préparé par l'équipe ou demandé par la personne (« Mot de passe oublié ») : empreinte SHA-256
  /// du jeton (valable 24 h, une seule fois)
  jetonReinitialisation String?   @unique @map("jeton_reinitialisation") @db.VarChar(64)
  jetonExpireLe         DateTime? @map("jeton_expire_le") @db.Timestamptz(0)
  /// E-mail confirmé par le lien reçu à l'inscription (null : pas encore) ; le logiciel affiche « e-mail vérifié ✓ »
  emailVerifieLe        DateTime? @map("email_verifie_le") @db.Timestamptz(0)
  /// Lien de confirmation de l'e-mail : empreinte SHA-256 du jeton (valable 7 jours, une seule fois)
  jetonVerification     String?   @unique @map("jeton_verification") @db.VarChar(64)
  jetonVerificationExpireLe DateTime? @map("jeton_verification_expire_le") @db.Timestamptz(0)
  creeLe                DateTime  @default(now()) @map("cree_le") @db.Timestamptz(0)
  modifieLe             DateTime  @default(now()) @updatedAt @map("modifie_le") @db.Timestamptz(0)
  /// Profil de l'app (décidé le 8 et le 9 octobre 2026, docs/decisions.md, « Comptes et données de l'app ») : pseudo unique
  /// (3 à 20 caractères, règles de packages/commun) pour que les potes te trouvent ; null tant qu'il n'est pas choisi
  pseudo                String?   @unique @db.VarChar(20)
  /// Nom (facultatif) et date de naissance (AAAA-MM-JJ), CHIFFRÉS par l'API (AES-256-GCM, clé hors de la base) ; la date
  /// de naissance n'est corrigée que par l'équipe. Les comptes du site (ambassadeur, pro) ne les ont pas.
  nomChiffre            String?   @map("nom_chiffre") @db.VarChar(200)
  dateNaissanceChiffree String?   @map("date_naissance_chiffree") @db.VarChar(200)
  /// Ville du profil de l'app (celle de l'ambassadeur est sur sa fiche Ambassadeur)
  ville                 String?   @db.VarChar(80)
  /// Envies par catégorie ({ lieux: [...], cuisines: [...] }), SANS les régimes (qui restent sur le téléphone sans accord
  /// explicite, RGPD article 9)
  envies                Json?
  /// Avatar : un emoji (une photo reste sur le téléphone)
  avatar                String?   @db.VarChar(16)
  /// Compte privé : les abonnements passent par une demande
  prive                 Boolean   @default(false)
  /// Dernière visite connectée (au plus une écriture par jour)
  derniereConnexion     DateTime  @default(now()) @map("derniere_connexion") @db.Timestamptz(0)

  ambassadeur   Ambassadeur?
  sessions      SessionCompte[]
  badges        BadgeCompte[]
  journalPoints JournalPoints[]
  candidatures  CandidatureFondateur[]
  demandesLieux DemandeLieu[]
  missions      MissionAmbassadeur[]
  messages      MessageAmbassadeur[]
  lectures      LectureMessage[]
  bigSos        BigSos[]
  appareils     AppareilPush[]
  candidaturesCertification CandidatureCertification[]
  suggestionsLieux          SuggestionLieu[]
  rattachementsLieux        RattachementLieu[]
  chartesMiamSafe           CharteMiamSafe[]
  alertesMiamSafe           AlerteMiamSafe[]           @relation("AlertesEnvoyees")
  alertesMiamSafeRepondues  AlerteMiamSafe[]           @relation("AlertesRepondues")
  signalementsMiamSafe      SignalementMiamSafe[]
  reponsesSentiBien         ReponseSentiBien[]
  // Activité de l'app, visites, fidélité et SOS du soir (session de l'app, 9 octobre 2026)
  rescousses                Rescousse[]
  premiersSauvetages        PremierSauveteur[]
  lieuxGardes               LieuGarde[]
  jaimesPublications        JaimePublication[]
  publicationsMasquees      PublicationMasquee[]
  suivisLieux               SuiviLieu[]
  suivisCreateurs           SuiviCreateur[]
  visites                   Visite[]                   @relation("VisitesClient")
  visitesDecidees           Visite[]                   @relation("VisitesDecidees")
  presentationsQr           PresentationQr[]           @relation("PresentationsMontrees")
  cartesFidelite            CarteFidelite[]
  recompensesOffertes       RecompensePrete[]          @relation("RecompensesOffertes")
  sosLances                 SosLieu[]

  @@index([derniereConnexion])
  @@map("comptes")
}

/// Ce qui est propre à l'espace ambassadeur du site : dès 18 ans, chaque inscription est validée par l'équipe dans le
/// logiciel de gestion. Refusé : seul le rôle (cette ligne) part 30 jours après le refus, le compte reste.
model Ambassadeur {
  compteId   Int       @id @map("compte_id")
  /// « en-attente » (à l'inscription), « actif », « refuse » ou « suspendu »
  statut     String    @default("en-attente") @db.VarChar(12)
  ville      String    @db.VarChar(80)
  quartier   String?   @db.VarChar(80)
  /// Note privée de l'équipe : jamais montrée dans l'espace (mais comprise dans les données transmises sur demande)
  noteEquipe String?   @map("note_equipe") @db.VarChar(2000)
  /// Date de la dernière décision de l'équipe (validation, refus ou suspension)
  decideLe   DateTime? @map("decide_le") @db.Timestamptz(0)
  /// Ambassadeur certifié (docs/decisions.md) : depuis quand (null : pas certifié), titre à part du palier
  certifieLe     DateTime? @map("certifie_le") @db.Timestamptz(0)
  /// Profil du certifié : « ambassadeur », « pro » ou « structure »
  profilCertifie String?   @map("profil_certifie") @db.VarChar(12)
  /// Nom de sa structure ou de son lieu, montré avec son prénom sur le badge (« Marie, pour l'asso … »)
  structure      String?   @db.VarChar(100)
  creeLe     DateTime  @default(now()) @map("cree_le") @db.Timestamptz(0)

  compte Compte @relation(fields: [compteId], references: [id], onDelete: Cascade)

  @@index([statut])
  @@map("ambassadeurs")
}

/// Session d'un compte (site, plus tard app). Seule l'empreinte du jeton est gardée, ni adresse IP ni navigateur.
model SessionCompte {
  id        Int      @id @default(autoincrement())
  /// SHA-256 (hexadécimal) du jeton de session
  empreinte String   @unique @db.VarChar(64)
  compteId  Int      @map("compte_id")
  /// « site » (plus tard « app »)
  support   String   @default("site") @db.VarChar(4)
  creeLe    DateTime @default(now()) @map("cree_le") @db.Timestamptz(3)
  activite  DateTime @default(now()) @db.Timestamptz(3)

  compte Compte @relation(fields: [compteId], references: [id], onDelete: Cascade)

  @@index([compteId])
  @@map("sessions_comptes")
}

/// Badge obtenu : « premier-sauveteur », « deniche-par-toi », « fondateur »…
model BadgeCompte {
  id       Int      @id @default(autoincrement())
  compteId Int      @map("compte_id")
  badge    String   @db.VarChar(30)
  obtenuLe DateTime @default(now()) @map("obtenu_le") @db.Timestamptz(0)

  compte Compte @relation(fields: [compteId], references: [id], onDelete: Cascade)

  @@unique([compteId, badge])
  @@map("badges_comptes")
}

/// Points gagnés ou retirés, et pourquoi. Le total et le palier du compte suivent (ajouterPoints, services/comptes.ts).
model JournalPoints {
  id       Int      @id @default(autoincrement())
  compteId Int      @map("compte_id")
  /// Positif (gagné) ou négatif (retiré)
  points   Int
  /// Code du barème (« visite », « visite-sos », « avis-photo », « proposer-lieu », « corriger-fiche »,
  /// « premier-sauveteur », « rescousse », « defi ») ou « equipe » (à la main)
  raison   String   @db.VarChar(40)
  /// Précision lisible : « Chez Mamie Rose a rejoint SOS Miam »
  detail   String?  @db.VarChar(200)
  creeLe   DateTime @default(now()) @map("cree_le") @db.Timestamptz(0)

  compte Compte @relation(fields: [compteId], references: [id], onDelete: Cascade)

  @@index([compteId, creeLe])
  @@map("journal_points")
}

/// Candidature pour être fondateur de sa ville, ou de son département si sa commune a moins de 50 000 habitants (places
/// par zone : ZoneFondateur, dans fondateurs.prisma). Refusée : effacée 3 mois après la réponse.
model CandidatureFondateur {
  id               Int       @id @default(autoincrement())
  compteId         Int       @map("compte_id")
  /// Les 3 pépites du quartier, et pourquoi
  pepites          String    @db.VarChar(1500)
  /// Ce que la personne aimerait faire, séparé par des virgules : « denicher », « fiches », « selections », « faire-savoir »
  envies           String    @db.VarChar(80)
  /// Réseaux sociaux (facultatif)
  reseaux          String?   @db.VarChar(200)
  /// « Pourquoi toi ? »
  motivation       String    @db.VarChar(600)
  /// Partant pour la visio des fondateurs de sa ville (environ 30 minutes)
  partantRencontre Boolean   @map("partant_rencontre")
  /// Comment la personne a connu SOS Miam (facultatif)
  connuPar         String?   @map("connu_par") @db.VarChar(120)
  /// « en-attente », « acceptee », « refusee » ou « souvenir » (fondateur qui a déménagé : il garde ses numéros et son
  /// titre, mais ne compte plus dans les places de sa zone)
  statut           String    @default("en-attente") @db.VarChar(12)
  /// Ancien numéro de 1 à 10, à retirer dans une prochaine migration (plus utilisé : numeroLocal et numeroNational)
  numero           Int?
  /// Commune déclarée par la personne : son code INSEE (« 69123 » ; un arrondissement est rendu comme sa commune)
  communeCode      String?   @map("commune_code") @db.VarChar(5)
  /// Zone où elle candidate : sa ville, ou son département si sa commune a moins de 50 000 habitants
  zoneCode         String?   @map("zone_code") @db.VarChar(5)
  /// Numéro dans sa zone (« Fondateur n° 3 de Lyon »), donné à l'acceptation, jamais redonné
  numeroLocal      Int?      @map("numero_local")
  /// Numéro dans toute la France (« n° 147 en France »), donné à l'acceptation, jamais redonné
  numeroNational   Int?      @unique @map("numero_national")
  creeLe           DateTime  @default(now()) @map("cree_le") @db.Timestamptz(0)
  reponduLe        DateTime? @map("repondu_le") @db.Timestamptz(0)

  compte Compte         @relation(fields: [compteId], references: [id], onDelete: Cascade)
  /// Une zone qui a des candidatures ne peut pas être effacée (leurs numéros en dépendent)
  zone   ZoneFondateur? @relation(fields: [zoneCode], references: [code], onDelete: Restrict)

  @@unique([zoneCode, numeroLocal])
  @@index([compteId])
  @@index([statut, creeLe])
  @@index([zoneCode, statut])
  @@map("candidatures_fondateurs")
}
