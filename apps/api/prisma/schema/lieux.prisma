// Lieux, fil « Pour toi » et modération

/// Fiche d'un lieu, saisie dans le logiciel de gestion (forme proche du type Lieu de packages/commun).
model Lieu {
  id           Int                  @id @default(autoincrement())
  nom          String               @db.VarChar(80)
  /// « resto », « patisserie », « bar » ou « sortie »
  type         String               @db.VarChar(20)
  emoji        String               @db.VarChar(16)
  /// Ce que c'est, en quelques mots : « Trattoria », « Bar à cocktails »…
  info         String               @db.VarChar(60)
  texte        String               @db.VarChar(1000)
  adresse      String?              @db.VarChar(160)
  quartier     String               @db.VarChar(60)
  ville        String               @db.VarChar(80)
  latitude     Float?
  longitude    Float?
  /// « € », « €€ » ou « €€€ »
  prix         String               @db.VarChar(3)
  prixMoyen    Int?                 @map("prix_moyen")
  /// Les deux couleurs du dégradé du lieu (« #FFD60A »)
  couleurs     String[]             @db.VarChar(9)
  /// Horaires lisibles : « Mar–sam, 12h–14h30 et 19h–23h »
  horaires     String               @db.VarChar(160)
  /// Créneaux d'ouverture : [{ jours: number[], de: "HH:MM", a: "HH:MM" }]
  ouverture    Json                 @default("[]")
  plat         String               @db.VarChar(80)
  tags         String[]             @db.VarChar(40)
  envies       String[]             @db.VarChar(20)
  reservable   Boolean              @default(false)
  telephone    String?              @db.VarChar(30)
  siteWeb      String?              @map("site_web") @db.VarChar(200)
  instagram    String?              @db.VarChar(60)
  /// Infos pratiques (docs/decisions.md, « Infos pratiques des lieux ») ; null ou liste vide : inconnu, jamais affiché.
  /// Animaux : « bienvenus », « terrasse » (seulement en terrasse) ou « non »
  animaux      String?              @db.VarChar(10)
  /// Accessible en fauteuil roulant (entrée et salle)
  accessible   Boolean?
  terrasse     Boolean?
  wifi         Boolean?
  /// Chaise haute ou menu enfant
  enfants      Boolean?
  /// Parking facile juste à côté
  parking      Boolean?
  /// « cb », « sans-contact », « especes », « tickets-resto », « cheques-vacances »
  paiements    String[]             @default([])
  /// Réservation : « inutile », « conseillee » ou « obligatoire »
  reservation  String?              @db.VarChar(12)
  /// La carte du lieu (plats, boissons, formules), au format CarteLieu de packages/commun (types/carte.ts), vérifiée par
  /// validerCarteDuLieu ; null : pas de carte. Remplie par le gérant (espace pro du site, mode pro de l'app).
  carte        Json?
  /// Dernière mise à jour de la carte, posée par l'API
  carteMajLe   DateTime?            @map("carte_maj_le") @db.Timestamptz(0)
  banniere     String?              @db.VarChar(64)
  logo         String?              @db.VarChar(64)
  imagesMajLe  DateTime?            @map("images_maj_le") @db.Timestamptz(0)
  /// Prénom de la personne qui l'a fait découvrir
  decouvertPar String?              @map("decouvert_par") @db.VarChar(40)
  /// « brouillon », « publie » ou « masque »
  statut       String               @default("brouillon") @db.VarChar(12)
  /// Première mise en ligne : un lieu reste « nouveau » 30 jours après (badge « Nouveau », premier sauveteur possible)
  publieLe     DateTime?            @map("publie_le") @db.Timestamptz(0)
  /// Message du moment, posé par le lieu : « Salle calme ce soir » (montré jusqu'à alerteJusqua)
  alerte       String?              @db.VarChar(80)
  alerteJusqua DateTime?            @map("alerte_jusqua") @db.Timestamptz(0)
  /// Note interne, jamais montrée au public
  note         String?              @db.VarChar(1000)
  creeLe       DateTime             @default(now()) @map("cree_le") @db.Timestamptz(0)
  modifieLe    DateTime             @default(now()) @updatedAt @map("modifie_le") @db.Timestamptz(0)
  publications Publication[]
  missions     MissionAmbassadeur[]
  bigSos       BigSos[]
  suggestions  SuggestionLieu[]
  rattachements RattachementLieu[]
  miamSafe      CharteMiamSafe?
  alertesMiamSafe       AlerteMiamSafe[]
  signalementsMiamSafe  SignalementMiamSafe[]
  reponsesSentiBien     ReponseSentiBien[]
  partagesPositionMiamSafe PartagePositionMiamSafe[]
  // Activité de l'app, visites, fidélité et SOS du soir (session de l'app, 9 octobre 2026)
  rescousses            Rescousse[]
  premierSauveteur      PremierSauveteur?
  gardesPar             LieuGarde[]
  suivisPar             SuiviLieu[]
  validation            ValidationLieu?
  presentationsQr       PresentationQr[]
  visites               Visite[]
  programmeFidelite     ProgrammeFidelite?
  cartesFidelite        CarteFidelite[]
  sos                   SosLieu[]
  // Événements, vues des fiches, avis et réservations (session de l'app, 9 octobre 2026 au soir)
  evenements            EvenementLieu[]
  vues                  VueLieu[]
  avis                  Avis[]
  reservations          Reservation[]
  reglagesReservations  ReglagesReservations?
  // Sorties, listes et commentaires (session de l'app, 14 octobre 2026). Le lieu d'un message est chiffré : pas de relation
  propositionsSorties   PropositionSortie[]
  sortiesRetenues       Sortie[]                 @relation("SortiesRetenues")
  dansLesListes         LieuDeListe[]
  commentairesCommeLieu CommentairePublication[]
  sortiesDesMiamis      SortieDesMiamis[]
  articlesActus         LieuArticleActus[]
  reponsesActus         ReponseLieuActus[]

  @@index([statut, ville])
  @@map("lieux")
}

/// Une publication du fil « Pour toi » : une vidéo ou des photos d'un lieu, postées par le lieu ou par un créateur.
model Publication {
  id           Int                @id @default(autoincrement())
  lieuId       Int                @map("lieu_id")
  lieu         Lieu               @relation(fields: [lieuId], references: [id], onDelete: Cascade)
  /// « lieu » ou « createur »
  auteurType   String             @map("auteur_type") @db.VarChar(10)
  auteurPseudo String?            @map("auteur_pseudo") @db.VarChar(40)
  /// Ce que le lieu a offert ou payé au créateur : affiché « Collaboration commerciale »
  partenariat  String?            @db.VarChar(120)
  legende      String             @db.VarChar(500)
  /// Média qui illustre le lieu sans y avoir été filmé : « Vidéo / Photos d'illustration »
  illustration Boolean            @default(false)
  /// « brouillon », « publiee » ou « masquee » (publiée avec une date future = programmée)
  statut       String             @default("brouillon") @db.VarChar(12)
  /// Masquée pour tout le monde par un signalement grave (« choquant »), en attendant la décision de la modération
  suspendue    Boolean            @default(false)
  publieeLe    DateTime?          @map("publiee_le") @db.Timestamptz(0)
  creeLe       DateTime           @default(now()) @map("cree_le") @db.Timestamptz(0)
  modifieLe    DateTime           @default(now()) @updatedAt @map("modifie_le") @db.Timestamptz(0)
  medias       MediaPublication[]
  jaimes       JaimePublication[]
  masqueePar   PublicationMasquee[]
  commentaires CommentairePublication[]

  @@index([statut, publieeLe])
  @@map("publications")
}

/// Fichier d'une publication, rangé dans le dossier des médias (DOSSIER_MEDIAS) sous un nom tiré au hasard.
model MediaPublication {
  id            Int         @id @default(autoincrement())
  publicationId Int         @map("publication_id")
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  /// « video », « affiche » (image de la vidéo) ou « photo »
  type          String      @db.VarChar(10)
  fichier       String      @unique @db.VarChar(80)
  typeMime      String      @map("type_mime") @db.VarChar(40)
  taille        Int
  ordre         Int         @default(0)

  @@map("medias_publications")
}

/// Un contenu signalé depuis l'app (forme : packages/commun/src/types/signalement.ts). Une publication signalée sans compte ne
/// garde pas qui l'a fait ; un contenu social garde qui l'a signalé, son auteur et un instantané chiffré.
model Signalement {
  id          Int       @id @default(autoincrement())
  /// « publication », « commentaire », « message », « liste », « profil », « sortie » ou « groupe » (12 caractères au plus)
  cible       String    @db.VarChar(12)
  cibleId     String    @map("cible_id") @db.VarChar(40)
  /// Lieu concerné, pour regrouper les signalements
  lieuId      Int?      @map("lieu_id")
  /// Une des RAISONS_SIGNALEMENT de packages/commun : « faux-lieu », « pub-cachee », « arnaque », « haine »…
  raison      String    @db.VarChar(12)
  /// Précision choisie parmi celles proposées pour la raison
  precision   String?   @db.VarChar(80)
  /// Ce que la personne a expliqué avec ses mots
  explication String    @default("") @db.VarChar(500)
  /// « app », « site », « discord » ou « lieu » (commentaire masqué par le gérant du lieu)
  source      String    @db.VarChar(10)
  /// « a-traiter », « retenu » (contenu masqué) ou « rejete » (rien à redire)
  statut      String    @default("a-traiter") @db.VarChar(10)
  /// Note de la modération (privée)
  decision    String?   @db.VarChar(500)
  /// Règle enfreinte quand le signalement est retenu (« haine », « arnaque »… : les règles de la communauté des CGU)
  motif       String?   @db.VarChar(20)
  /// Pourquoi, en clair, pour l'auteur (exposé des motifs du règlement européen sur les services numériques, art. 17)
  motivation  String?   @db.VarChar(1000)
  /// Contestation reçue (de l'auteur, ou de la personne qui a signalé) : son texte et sa date ; réexamen fait le…
  contestation String?  @db.VarChar(1000)
  contesteLe  DateTime? @map("conteste_le") @db.Timestamptz(0)
  reexamineLe DateTime? @map("reexamine_le") @db.Timestamptz(0)
  creeLe      DateTime  @default(now()) @map("cree_le") @db.Timestamptz(0)
  traiteLe    DateTime? @map("traite_le") @db.Timestamptz(0)
  /// Contenus sociaux (commentaire, message, liste, profil, sortie, groupe) : le compte qui a signalé, pour lui dire ce qu'on
  /// a décidé (règlement européen sur les services numériques) et ne compter qu'un signalement par personne ; null pour une
  /// publication signalée sans compte (POST /signalements), ou si son compte a été supprimé depuis
  signaleParId      Int?    @map("signale_par_id")
  signalePar        Compte? @relation("SignalementsFaits", fields: [signaleParId], references: [id], onDelete: SetNull)
  /// L'auteur du contenu signalé (message, commentaire ou réponse du lieu : qui l'a écrit ; liste : son auteur ; profil :
  /// son compte ; sortie : l'organisateur ; groupe : son créateur), pour le prévenir dès le masquage et de la décision, et
  /// le laisser contester (DSA, art. 17 et 20) ; null s'il a supprimé son compte depuis
  auteurContenuId   Int?    @map("auteur_contenu_id")
  auteurContenu     Compte? @relation("ContenusSignales", fields: [auteurContenuId], references: [id], onDelete: SetNull)
  /// L'instantané : le contenu tel qu'il était au moment du signalement, en JSON CHIFFRÉ (sous-clé
  /// « sos-miam/moderation/instantanes/v1 », contexte « signalement:<id> »). Message : type, texte, lieuId, type de
  /// conversation, emoji et titre du groupe ; commentaire : texte, mentions, publication, réponse du lieu ou non ; liste :
  /// titre, emoji, description, visibilité, lieux ; profil : pseudo, prénom, avatar ; sortie et groupe : titre, emoji, lieux
  /// proposés. Écrit dans la même transaction que le signalement. La modération lit ceci, jamais le contenu vivant : effacer,
  /// modifier ou annuler le contenu ne fait pas disparaître la preuve
  instantaneChiffre String? @map("instantane_chiffre") @db.VarChar(6000)
  /// Photo ou note vocale d'un message signalé : son fichier chiffré, gardé sur le disque tant que le signalement n'est pas
  /// jugé, même si le message, la conversation ou le compte de l'auteur disparaissent (le nom est tiré au hasard : rien de
  /// personnel)
  fichierMedia      String? @map("fichier_media") @db.VarChar(80)

  @@index([statut, creeLe])
  @@index([signaleParId, cible])
  @@index([cible, cibleId])
  @@index([auteurContenuId])
  @@index([fichierMedia])
  @@map("signalements")
}
