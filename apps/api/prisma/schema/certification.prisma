// Ambassadeur certifié (décidé le 9 octobre 2026, voir docs/decisions.md)

/// Candidature au titre d'ambassadeur certifié, envoyée depuis l'espace par un ambassadeur validé. L'équipe répond dans le
/// logiciel de gestion ; une candidature refusée est effacée 3 mois après la réponse (comme pour les fondateurs).
model CandidatureCertification {
  id                Int       @id @default(autoincrement())
  compteId          Int       @map("compte_id")
  /// « ambassadeur », « pro » ou « structure »
  profil            String    @db.VarChar(12)
  /// Nom de la structure ou du lieu (facultatif)
  structure         String?   @db.VarChar(100)
  /// Commune INSEE déclarée
  communeCode       String    @map("commune_code") @db.VarChar(5)
  /// Comment la personne aide déjà les lieux
  aide              String    @db.VarChar(600)
  /// Ce qu'elle aimerait faire, séparé par des virgules : « fiche », « photos », « presenter », « big-sos »
  envies            String    @db.VarChar(80)
  /// A coché « jamais payé par un lieu (sinon « Collaboration commerciale ») »
  engagementGratuit Boolean   @map("engagement_gratuit")
  /// « en-attente », « acceptee » ou « refusee »
  statut            String    @default("en-attente") @db.VarChar(12)
  creeLe            DateTime  @default(now()) @map("cree_le") @db.Timestamptz(0)
  reponduLe         DateTime? @map("repondu_le") @db.Timestamptz(0)

  compte Compte @relation(fields: [compteId], references: [id], onDelete: Cascade)

  @@index([compteId])
  @@index([statut, creeLe])
  @@map("candidatures_certification")
}
