// Schéma de la base de SOS Miam (PostgreSQL). Après chaque changement : npm run base:nouvelle-migration
generator client {
  provider               = "prisma-client"
  output                 = "../src/base-de-donnees/client-genere"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

/// Une adresse inscrite pour être prévenue du lancement puis recevoir la newsletter.
/// Aucune adresse IP n'est gardée. Les désinscriptions par mail sont traitées par scripts/recuperer-inscrits.py.
model InscriptionNewsletter {
  id                  Int      @id @default(autoincrement())
  email               String   @unique @db.VarChar(254)
  ville               String?  @db.VarChar(80)
  /// La personne a coché « Je veux devenir ambassadeur fondateur » (au moins une fois)
  ambassadeur         Boolean  @default(false)
  /// Son téléphone, pour savoir sur quel store publier l'app : « iphone », « android », ou rien si non précisé
  telephone           String?  @db.VarChar(10)
  /// La personne veut tester l'app avant sa sortie (bêta), au moins une fois
  beta                Boolean  @default(false)
  /// D'où vient l'inscription : « site » pour le formulaire de l'accueil
  source              String   @db.VarChar(40)
  premiereInscription DateTime @default(now()) @map("premiere_inscription") @db.Timestamptz(0)
  derniereInscription DateTime @default(now()) @map("derniere_inscription") @db.Timestamptz(0)

  @@map("inscriptions_newsletter")
}

// ─── Statistiques de visite (site, puis app) ─────────────────────────────────────────────────
// Uniquement des totaux : aucune adresse IP, aucun identifiant de visiteur n'est enregistré.

/// Totaux d'une période. Les visiteurs uniques sont estimés par une « esquisse » HyperLogLog :
/// elle ne contient aucune empreinte de visiteur, et elle est effacée avec son secret à la fin de la période.
model StatPeriode {
  id            Int    @id @default(autoincrement())
  /// « site » ou « app »
  source        String @db.VarChar(10)
  /// « jour », « semaine », « mois » ou « annee »
  type          String @db.VarChar(10)
  /// Repère de la période, à l'heure de Paris : « 2026-10-08 », « 2026-S41 », « 2026-10 », « 2026 »
  cle           String @db.VarChar(10)
  vues          Int    @default(0)
  visites       Int    @default(0)
  visiteurs     Int    @default(0)
  /// Visites terminées (30 minutes sans page vue), et parmi elles celles d'une seule page (rebonds)
  visitesFinies Int    @default(0) @map("visites_finies")
  rebonds       Int    @default(0)
  /// Durée totale des visites terminées, en secondes (de la première à la dernière page)
  dureeVisites  Int    @default(0) @map("duree_visites")
  /// Temps de réponse du serveur : somme en millisecondes et nombre de pages mesurées
  tempsTotal    BigInt @default(0) @map("temps_total")
  pagesMesurees Int    @default(0) @map("pages_mesurees")
  /// Registres HyperLogLog, tant que la période est en cours
  esquisse      Bytes?
  /// Secret qui brouille les visiteurs de cette période, effacé à sa fin
  secret        Bytes?

  @@unique([source, type, cle])
  @@map("stats_periodes")
}

/// Détail d'un jour : vues par page, visites par provenance, appareil, navigateur, système et pays.
model StatDetail {
  id        Int    @id @default(autoincrement())
  source    String @db.VarChar(10)
  /// Jour, à l'heure de Paris : « 2026-10-08 »
  jour      String @db.VarChar(10)
  /// « page », « provenance », « appareil », « navigateur », « systeme » ou « pays »
  dimension String @db.VarChar(12)
  valeur    String @db.VarChar(120)
  nombre    Int    @default(0)

  @@unique([source, jour, dimension, valeur])
  @@index([source, dimension, jour])
  @@map("stats_details")
}

// ─── Lieux et fil « Pour toi » ────────────────────────────────────────────────────────────────

/// Fiche d'un lieu, saisie dans le logiciel de gestion (forme proche du type Lieu de packages/commun).
model Lieu {
  id           Int           @id @default(autoincrement())
  nom          String        @db.VarChar(80)
  /// « resto », « patisserie », « bar » ou « sortie »
  type         String        @db.VarChar(20)
  emoji        String        @db.VarChar(16)
  /// Ce que c'est, en quelques mots : « Trattoria », « Bar à cocktails »…
  info         String        @db.VarChar(60)
  texte        String        @db.VarChar(1000)
  adresse      String?       @db.VarChar(160)
  quartier     String        @db.VarChar(60)
  ville        String        @db.VarChar(80)
  latitude     Float?
  longitude    Float?
  /// « € », « €€ » ou « €€€ »
  prix         String        @db.VarChar(3)
  prixMoyen    Int?          @map("prix_moyen")
  /// Les deux couleurs du dégradé du lieu (« #FFD60A »)
  couleurs     String[]      @db.VarChar(9)
  /// Horaires lisibles : « Mar–sam, 12h–14h30 et 19h–23h »
  horaires     String        @db.VarChar(160)
  /// Créneaux d'ouverture : [{ jours: number[], de: "HH:MM", a: "HH:MM" }]
  ouverture    Json          @default("[]")
  plat         String        @db.VarChar(80)
  tags         String[]      @db.VarChar(40)
  envies       String[]      @db.VarChar(20)
  reservable   Boolean       @default(false)
  telephone    String?       @db.VarChar(30)
  siteWeb      String?       @map("site_web") @db.VarChar(200)
  instagram    String?       @db.VarChar(60)
  /// Prénom de la personne qui l'a fait découvrir
  decouvertPar String?       @map("decouvert_par") @db.VarChar(40)
  /// « brouillon », « publie » ou « masque »
  statut       String        @default("brouillon") @db.VarChar(12)
  /// Note interne, jamais montrée au public
  note         String?       @db.VarChar(1000)
  creeLe       DateTime      @default(now()) @map("cree_le") @db.Timestamptz(0)
  modifieLe    DateTime      @default(now()) @updatedAt @map("modifie_le") @db.Timestamptz(0)
  publications Publication[]

  @@index([statut, ville])
  @@map("lieux")
}

/// Une publication du fil « Pour toi » : une vidéo ou des photos d'un lieu, postées par le lieu ou par un créateur.
model Publication {
  id           Int                @id @default(autoincrement())
  lieuId       Int                @map("lieu_id")
  lieu         Lieu               @relation(fields: [lieuId], references: [id], onDelete: Cascade)
  /// « lieu » ou « createur »
  auteurType   String             @map("auteur_type") @db.VarChar(10)
  auteurPseudo String?            @map("auteur_pseudo") @db.VarChar(40)
  /// Ce que le lieu a offert ou payé au créateur : affiché « Collaboration commerciale »
  partenariat  String?            @db.VarChar(120)
  legende      String             @db.VarChar(500)
  /// Média qui illustre le lieu sans y avoir été filmé : « Vidéo / Photos d'illustration »
  illustration Boolean            @default(false)
  /// « brouillon », « publiee » ou « masquee » (publiée avec une date future = programmée)
  statut       String             @default("brouillon") @db.VarChar(12)
  /// Masquée pour tout le monde par un signalement grave (« choquant »), en attendant la décision de la modération
  suspendue    Boolean            @default(false)
  publieeLe    DateTime?          @map("publiee_le") @db.Timestamptz(0)
  creeLe       DateTime           @default(now()) @map("cree_le") @db.Timestamptz(0)
  modifieLe    DateTime           @default(now()) @updatedAt @map("modifie_le") @db.Timestamptz(0)
  medias       MediaPublication[]

  @@index([statut, publieeLe])
  @@map("publications")
}

/// Fichier d'une publication, rangé dans le dossier des médias (DOSSIER_MEDIAS) sous un nom tiré au hasard.
model MediaPublication {
  id            Int         @id @default(autoincrement())
  publicationId Int         @map("publication_id")
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  /// « video », « affiche » (image de la vidéo) ou « photo »
  type          String      @db.VarChar(10)
  fichier       String      @unique @db.VarChar(80)
  typeMime      String      @map("type_mime") @db.VarChar(40)
  taille        Int
  ordre         Int         @default(0)

  @@map("medias_publications")
}

// ─── Modération ───────────────────────────────────────────────────────────────────────────────

/// Un contenu signalé depuis l'app (forme : packages/commun/src/types/signalement.ts). Le signalement ne garde pas qui l'a fait.
model Signalement {
  id          Int       @id @default(autoincrement())
  /// « publication » pour l'instant (plus tard : commentaire, avis, profil)
  cible       String    @db.VarChar(12)
  cibleId     String    @map("cible_id") @db.VarChar(40)
  /// Lieu concerné, pour regrouper les signalements
  lieuId      Int?      @map("lieu_id")
  /// Une des RAISONS_SIGNALEMENT de packages/commun : « faux-lieu », « pub-cachee », « arnaque », « haine »…
  raison      String    @db.VarChar(12)
  /// Précision choisie parmi celles proposées pour la raison
  precision   String?   @db.VarChar(80)
  /// Ce que la personne a expliqué avec ses mots
  explication String    @default("") @db.VarChar(500)
  /// « app », « site » ou « discord »
  source      String    @db.VarChar(10)
  /// « a-traiter », « retenu » (contenu masqué) ou « rejete » (rien à redire)
  statut      String    @default("a-traiter") @db.VarChar(10)
  /// Note de la modération
  decision    String?   @db.VarChar(500)
  creeLe      DateTime  @default(now()) @map("cree_le") @db.Timestamptz(0)
  traiteLe    DateTime? @map("traite_le") @db.Timestamptz(0)

  @@index([statut, creeLe])
  @@map("signalements")
}

// ─── Newsletter et journal de gestion ─────────────────────────────────────────────────────────

/// Newsletter en cours de rédaction dans le logiciel de gestion (l'envoi arrivera avec Brevo).
model BrouillonNewsletter {
  id        Int      @id @default(autoincrement())
  objet     String   @db.VarChar(150)
  /// Texte en Markdown simple : titres (#), gras (**), liens [texte](adresse), listes (-)
  texte     String   @db.VarChar(20000)
  creeLe    DateTime @default(now()) @map("cree_le") @db.Timestamptz(0)
  modifieLe DateTime @default(now()) @updatedAt @map("modifie_le") @db.Timestamptz(0)

  @@map("brouillons_newsletter")
}

/// Ce qui a été fait depuis le logiciel de gestion : qui (le poste), quoi, quand. Aucune donnée personnelle.
model JournalGestion {
  id     Int      @id @default(autoincrement())
  moment DateTime @default(now()) @db.Timestamptz(0)
  /// Nom du poste autorisé (« PC de Hugo »), ou « serveur »
  poste  String   @db.VarChar(40)
  action String   @db.VarChar(60)
  detail String?  @db.VarChar(300)

  @@index([moment])
  @@map("journal_gestion")
}

// ─── Demandes de lieux et annonces Discord ────────────────────────────────────────────────────

/// Un lieu qui demande à être sur SOS Miam (formulaire du site) ou une pépite proposée par la communauté (Discord).
/// Hugo l'accepte (une fiche de lieu est créée) ou la refuse, dans le logiciel de gestion.
model DemandeLieu {
  id               Int       @id @default(autoincrement())
  /// « lieu » (le lieu s'inscrit lui-même, depuis le site), « communaute » (proposition depuis Discord) ou « ambassadeur »
  /// (proposition depuis l'espace ambassadeur du site, liée au compte)
  origine          String    @db.VarChar(12)
  nom              String    @db.VarChar(80)
  /// « resto », « patisserie », « bar », « sortie » ou « autre »
  type             String?   @db.VarChar(20)
  ville            String    @db.VarChar(80)
  adresse          String?   @db.VarChar(160)
  /// Présentation du lieu, ou pourquoi la communauté le propose
  description      String    @db.VarChar(1000)
  plat             String?   @db.VarChar(80)
  horaires         String?   @db.VarChar(160)
  siteWeb          String?   @map("site_web") @db.VarChar(200)
  instagram        String?   @db.VarChar(60)
  /// Contact du lieu (origine « lieu ») : pour lui répondre ; effaçable depuis le logiciel
  contactNom       String?   @map("contact_nom") @db.VarChar(80)
  contactEmail     String?   @map("contact_email") @db.VarChar(254)
  contactTelephone String?   @map("contact_telephone") @db.VarChar(30)
  /// Lien vers le message de la proposition sur Discord (origine « communaute »)
  lienDiscord      String?   @map("lien_discord") @db.VarChar(200)
  /// « a-traiter », « acceptee » ou « refusee »
  statut           String    @default("a-traiter") @db.VarChar(10)
  /// Note ou motif de la décision
  reponse          String?   @db.VarChar(1000)
  /// Fiche créée à partir de la demande
  lieuId           Int?      @map("lieu_id")
  /// Compte de l'ambassadeur qui propose (origine « ambassadeur ») ; vidé si le compte est supprimé
  compteId         Int?      @map("compte_id")
  compte           Compte?   @relation(fields: [compteId], references: [id], onDelete: SetNull)
  creeLe           DateTime  @default(now()) @map("cree_le") @db.Timestamptz(0)
  traiteLe         DateTime? @map("traite_le") @db.Timestamptz(0)

  @@index([statut, creeLe])
  @@index([compteId])
  @@map("demandes_lieux")
}

/// Annonce écrite dans le logiciel de gestion, publiée dans le salon d'annonces du serveur Discord par le bot.
model AnnonceDiscord {
  id          Int       @id @default(autoincrement())
  titre       String    @db.VarChar(100)
  /// Texte au format Discord (gras **…**, listes « - », liens)
  texte       String    @db.VarChar(3500)
  /// « en-attente » (le bot va la publier), « publiee » ou « echec »
  statut      String    @default("en-attente") @db.VarChar(12)
  lienMessage String?   @map("lien_message") @db.VarChar(200)
  erreur      String?   @db.VarChar(300)
  creeLe      DateTime  @default(now()) @map("cree_le") @db.Timestamptz(0)
  publieeLe   DateTime? @map("publiee_le") @db.Timestamptz(0)

  @@index([statut])
  @@map("annonces_discord")
}

/// Session ouverte par un poste du logiciel de gestion (code à 6 chiffres). Seule l'empreinte de l'identifiant est
/// gardée : la session ne sert de toute façon qu'avec des demandes signées par la clé du poste.
model SessionGestion {
  id        Int      @id @default(autoincrement())
  /// SHA-256 (hexadécimal) de l'identifiant de session
  empreinte String   @unique @db.VarChar(64)
  posteId   String   @map("poste_id") @db.VarChar(20)
  creeLe    DateTime @default(now()) @map("cree_le") @db.Timestamptz(3)
  activite  DateTime @default(now()) @db.Timestamptz(3)

  @@map("sessions_gestion")
}

/// Réglage du logiciel de gestion gardé sur le serveur (ex. « objectif-mois »).
model ReglageGestion {
  cle       String   @id @db.VarChar(40)
  valeur    Json
  modifieLe DateTime @default(now()) @updatedAt @map("modifie_le") @db.Timestamptz(0)

  @@map("reglages_gestion")
}

// ─── Comptes et espace ambassadeur (décidé le 8 octobre 2026, voir docs/decisions.md) ─────────────────────────────

/// Un compte SOS Miam : celui de l'espace ambassadeur du site aujourd'hui, le même pour l'app plus tard (un compte par
/// personne). Ni date de naissance ni nom : l'âge (18 ans au moins pour l'espace ambassadeur) est vérifié à l'inscription,
/// puis oublié. Un compte sans visite connectée pendant 1 an est effacé (alerte avant dans le logiciel de gestion).
model Compte {
  id                    Int       @id @default(autoincrement())
  /// Adresse de connexion, en minuscules et sans espaces
  email                 String    @unique @db.VarChar(254)
  /// Empreinte scrypt qui se décrit elle-même (« scrypt$N$r$p$sel$empreinte ») ; jamais le mot de passe
  motDePasse            String    @map("mot_de_passe") @db.VarChar(200)
  prenom                String    @db.VarChar(40)
  /// Points du programme Ambassadeurs (barème dans docs/decisions.md), tenus par ajouterPoints avec le journal
  points                Int       @default(0)
  /// « curieux », « denicheur », « ambassadeur-quartier » ou « ambassadeur-ville » (ce dernier seulement à la main)
  palier                String    @default("curieux") @db.VarChar(20)
  /// Version des conditions d'utilisation acceptées à l'inscription (leur date de mise à jour, AAAA-MM-JJ)
  cguVersion            String    @map("cgu_version") @db.VarChar(10)
  /// Réinitialisation du mot de passe préparée par l'équipe : empreinte SHA-256 du jeton (valable 48 h)
  jetonReinitialisation String?   @unique @map("jeton_reinitialisation") @db.VarChar(64)
  jetonExpireLe         DateTime? @map("jeton_expire_le") @db.Timestamptz(0)
  creeLe                DateTime  @default(now()) @map("cree_le") @db.Timestamptz(0)
  modifieLe             DateTime  @default(now()) @updatedAt @map("modifie_le") @db.Timestamptz(0)
  /// Dernière visite connectée (au plus une écriture par jour)
  derniereConnexion     DateTime  @default(now()) @map("derniere_connexion") @db.Timestamptz(0)

  ambassadeur   Ambassadeur?
  sessions      SessionCompte[]
  badges        BadgeCompte[]
  journalPoints JournalPoints[]
  candidatures  CandidatureFondateur[]
  demandesLieux DemandeLieu[]

  @@index([derniereConnexion])
  @@map("comptes")
}

/// Ce qui est propre à l'espace ambassadeur du site : dès 18 ans, chaque inscription est validée par l'équipe dans le
/// logiciel de gestion. Un compte refusé est effacé 30 jours après le refus.
model Ambassadeur {
  compteId   Int       @id @map("compte_id")
  /// « en-attente » (à l'inscription), « actif », « refuse » ou « suspendu »
  statut     String    @default("en-attente") @db.VarChar(12)
  ville      String    @db.VarChar(80)
  quartier   String?   @db.VarChar(80)
  /// Note privée de l'équipe : jamais montrée dans l'espace (mais comprise dans les données transmises sur demande)
  noteEquipe String?   @map("note_equipe") @db.VarChar(2000)
  /// Date de la dernière décision de l'équipe (validation, refus ou suspension)
  decideLe   DateTime? @map("decide_le") @db.Timestamptz(0)
  creeLe     DateTime  @default(now()) @map("cree_le") @db.Timestamptz(0)

  compte Compte @relation(fields: [compteId], references: [id], onDelete: Cascade)

  @@index([statut])
  @@map("ambassadeurs")
}

/// Session d'un compte (site, plus tard app). Seule l'empreinte du jeton est gardée, ni adresse IP ni navigateur.
model SessionCompte {
  id        Int      @id @default(autoincrement())
  /// SHA-256 (hexadécimal) du jeton de session
  empreinte String   @unique @db.VarChar(64)
  compteId  Int      @map("compte_id")
  /// « site » (plus tard « app »)
  support   String   @default("site") @db.VarChar(4)
  creeLe    DateTime @default(now()) @map("cree_le") @db.Timestamptz(3)
  activite  DateTime @default(now()) @db.Timestamptz(3)

  compte Compte @relation(fields: [compteId], references: [id], onDelete: Cascade)

  @@index([compteId])
  @@map("sessions_comptes")
}

/// Badge obtenu : « premier-sauveteur », « deniche-par-toi », « fondateur »…
model BadgeCompte {
  id       Int      @id @default(autoincrement())
  compteId Int      @map("compte_id")
  badge    String   @db.VarChar(30)
  obtenuLe DateTime @default(now()) @map("obtenu_le") @db.Timestamptz(0)

  compte Compte @relation(fields: [compteId], references: [id], onDelete: Cascade)

  @@unique([compteId, badge])
  @@map("badges_comptes")
}

/// Points gagnés ou retirés, et pourquoi. Le total et le palier du compte suivent (ajouterPoints, services/comptes.ts).
model JournalPoints {
  id       Int      @id @default(autoincrement())
  compteId Int      @map("compte_id")
  /// Positif (gagné) ou négatif (retiré)
  points   Int
  /// Code du barème (« visite », « visite-sos », « avis-photo », « proposer-lieu », « corriger-fiche »,
  /// « premier-sauveteur », « rescousse », « defi ») ou « equipe » (à la main)
  raison   String   @db.VarChar(40)
  /// Précision lisible : « Chez Mamie Rose a rejoint SOS Miam »
  detail   String?  @db.VarChar(200)
  creeLe   DateTime @default(now()) @map("cree_le") @db.Timestamptz(0)

  compte Compte @relation(fields: [compteId], references: [id], onDelete: Cascade)

  @@index([compteId, creeLe])
  @@map("journal_points")
}

/// Candidature pour être l'un des 10 ambassadeurs fondateurs. Refusée : effacée 3 mois après la réponse.
model CandidatureFondateur {
  id               Int       @id @default(autoincrement())
  compteId         Int       @map("compte_id")
  /// Les 3 pépites du quartier, et pourquoi
  pepites          String    @db.VarChar(1500)
  /// Ce que la personne aimerait faire, séparé par des virgules : « denicher », « fiches », « selections », « faire-savoir »
  envies           String    @db.VarChar(80)
  /// Réseaux sociaux (facultatif)
  reseaux          String?   @db.VarChar(200)
  /// « Pourquoi toi ? »
  motivation       String    @db.VarChar(600)
  /// Partant pour faire connaissance 20 minutes, autour d'un café ou en visio
  partantRencontre Boolean   @map("partant_rencontre")
  /// Comment la personne a connu SOS Miam (facultatif)
  connuPar         String?   @map("connu_par") @db.VarChar(120)
  /// « en-attente », « acceptee » ou « refusee »
  statut           String    @default("en-attente") @db.VarChar(12)
  /// Numéro de la carte de fondateur (1 à 10), donné par l'équipe à l'acceptation
  numero           Int?
  creeLe           DateTime  @default(now()) @map("cree_le") @db.Timestamptz(0)
  reponduLe        DateTime? @map("repondu_le") @db.Timestamptz(0)

  compte Compte @relation(fields: [compteId], references: [id], onDelete: Cascade)

  @@index([compteId])
  @@index([statut, creeLe])
  @@map("candidatures_fondateurs")
}
