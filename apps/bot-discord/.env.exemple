# Copie ce fichier en .env (jamais commité) et remplis-le.

# Jeton du bot : portail Discord > ton application > Bot > Reset Token
DISCORD_JETON=

# 1 pour accueillir les nouveaux membres. Active d'abord « Server Members Intent » dans le portail (Bot > Privileged Gateway Intents),
# sinon Discord refuse la connexion.
INTENT_MEMBRES=0

# Lien avec l'API de SOS Miam (propositions de lieux et annonces du logiciel de gestion) : le même SECRET_BOT que dans
# apps/api/.env (au moins 32 caractères). Sans lui, propositions et annonces restent seulement sur Discord.
SECRET_BOT=
ADRESSE_API=http://127.0.0.1:5192
